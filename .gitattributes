# Normalize line endings to LF for all text files
* text=auto eol=lf

# Python
*.py text diff=python
*.pyi text diff=python
*.pyw text diff=python

# Markdown / docs
*.md text diff=markdown
*.rst text diff=rst
*.txt text

# Config files
*.cfg text
*.conf text
*.ini text
*.toml text
*.yaml text
*.yml text
*.json text diff=json

# Git / CI
*.gitignore text
*.gitattributes text
*.gitkeep text
Makefile text
Dockerfile text

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Jupyter
*.ipynb text

# Binaries (never diff or merge)
*.pt binary
*.pth binary
*.bin binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.tar binary

# Lock files — binary / generated
*.lock binary
