# Le Gros Chaton — Environment Variables
# Copy this to .env or export directly.
# ========================================

# --- Profile (required) ----------------------------------------------------
# CHATON_PROFILE=dev          # 14.4M dense — local dev on 2070
# CHATON_PROFILE=smol-fat     # 56.4M/42.3M MoE — pipeline proof (default)
# CHATON_PROFILE=fat          # 10.5B/3.83B MoE — A100-80GB

# --- Data pipeline ---------------------------------------------------------
# CHATON_DATA=code            # Code corpus via data_code.py (default)
# CHATON_DATA=wikitext        # Wikitext via data2.py (legacy)
# CHATON_CODE_CORPUS=starcoderdata   # HuggingFace dataset name
# CHATON_CODE_MAX_DOCS=200000        # Cap on documents to encode
# CHATON_CODE_MAX_TOKENS=50000000    # Cap on tokens to encode
# CHATON_CODE_BLOCK=4096             # Block size for memmap filename
# CHATON_PROSE_BLEND=0.1             # Fraction of prose in corpus (0-1)
# CHATON_VALIDATE_SYNTAX=1           # Skip non-parsing Python files
# CHATON_MIN_EDU_SCORE=0.0           # Educational quality threshold (0=off)
# CHATON_DEDUP_THRESHOLD=0.85        # MinHash dedup threshold (0=off)

# --- Architecture overrides ------------------------------------------------
# CHATON_MLP_TYPE=swiglu             # Override profile's MLP type
# CHATON_N_KV_HEAD=4                 # Override profile's KV heads
# CHATON_N_SHARED_EXPERT=1           # Override profile's shared experts
# CHATON_USE_QK_NORM=1               # Enable QK-norm (default: 1)
# CHATON_GRAD_CKPT=1                 # Enable gradient checkpointing
# CHATON_DYNAMIC_TOPK=1              # Dynamic top-k routing
# CHATON_DYNAMIC_TOPK_THRESHOLD=2.0  # Confidence threshold for dynamic top-k
# CHATON_ROPE_SCALE=1.0              # RoPE context extension factor
# CHATON_MAX_CACHE_LEN=0             # KV cache max (0 = block_size)
# CHATON_CACHE_N_SINK=4              # StreamingLLM sink tokens

# --- Training hyperparameters ----------------------------------------------
# CHATON_LR_SCHEDULE=wsd             # Learning rate schedule
# CHATON_COOLDOWN_ITERS=500          # WSD cooldown steps
# CHATON_WARMUP_ITERS=100            # Warmup steps
# CHATON_LR_MAX=3e-4                 # Peak learning rate
# CHATON_LR_MIN=1e-5                 # Minimum learning rate (cosine)
# CHATON_MICRO_BATCH=8               # Batch size per GPU step
# CHATON_GRAD_ACCUM=4                # Gradient accumulation steps
# CHATON_MAX_ITERS=10000             # Total training steps
# CHATON_EVAL_INTERVAL=250           # Steps between evals
# CHATON_EVAL_ITERS=50               # Samples for eval loss estimate
# CHATON_GRAD_CLIP=1.0               # Gradient norm clipping threshold
# CHATON_WEIGHT_DECAY=0.1            # AdamW weight decay
# CHATON_MOE_AUX_LOSS=0.01           # Load-balancing loss coefficient
# CHATON_MOE_Z_LOSS=0.001            # Z-loss coefficient
# CHATON_EMA_DECAY=0.999             # EMA decay (0 = disable EMA)
# CHATON_RESUME=1                    # Resume from checkpoint
# CHATON_CKPT_INTERVAL=500           # Steps between checkpoints
# CHATON_CKPT_PATH=checkpoint.pt     # Checkpoint file path
# CHATON_SEED=42                     # Random seed
# CHATON_COMPILE=1                   # Enable torch.compile

# --- Secrets (gitignored — stored in gpus.md) ------------------------------
# HF_TOKEN=hf_xxx                   # HuggingFace write token
# CHATON_HF_REPO=user/repo-name     # HF Hub repo for checkpoints
# WANDB_API_KEY=xxx                 # Weights & Biases key (if used)

# --- Kimi K3 innovations ---
# CHATON_QUANTILE_BALANCE=1       # Quantile-based MoE routing (replaces aux_loss)
# CHATON_USE_SITU=1               # Sigmoid Tanh Unit activation (avoids dead neurons)
# CHATON_MOE_LATENT_DIM=256       # Latent MoE compression dim (0 = disabled)
# CHATON_LEARNED_RESIDUAL=1       # Learnable per-layer residual scaling

# --- Testing/inference enhancements ---
# CHATON_N_SAMPLES=16             # Test-time compute scaling (eval/agent_eval.py)

# --- Modal cloud training --------------------------------------------------
# CHATON_HF_SECRET=chaton-hf        # Modal secret name for HF_TOKEN
# CHATON_GPU=L4                     # Modal GPU type
